// Writes the resting vitals and the ventricle trace Home shows into a static module, so Home's first load carries
// a few hundred bytes of numbers instead of the simulator. scripts/uji/home-body-stage.mts checks it stays current.
//   npx tsx scripts/bangun/home-body-snapshot.mts
import { writeFileSync } from 'node:fs'
import { DEFAULT_PARAMS } from '../../src/domains/body-exposure/engine/cardiacCycle.ts'
import { restingVitals, ventricleVolumeTrace } from '../../src/domains/body-exposure/engine/home-hero/homeBodyModels.ts'

export function snapshotSource(): string {
  const trace = ventricleVolumeTrace(DEFAULT_PARAMS, 2, 160, 44)
  if (!trace) throw new Error('ventricle trace refused DEFAULT_PARAMS')
  return `// GENERATED by scripts/bangun/home-body-snapshot.mts from lib/bodySim and the Wiggers cycle model. Do not edit.
// Simulated resting state of a textbook adult, not a measurement of anyone.
import type { RestingVital, VolumeTrace } from '../engine/home-hero/homeBodyModels.ts'

export const HOME_RESTING_VITALS: readonly RestingVital[] = ${JSON.stringify(restingVitals(), null, 2)}

export const HOME_VENTRICLE_TRACE: VolumeTrace = ${JSON.stringify(trace, null, 2)}
`
}

if (process.argv[1]?.endsWith('home-body-snapshot.mts')) {
  writeFileSync('src/domains/body-exposure/data/homeBodySnapshot.ts', snapshotSource())
  console.log('wrote src/domains/body-exposure/data/homeBodySnapshot.ts')
}
