import assert from 'node:assert/strict'
import { readFileSync } from 'node:fs'
const { ringkasLatihan, menitTujuhHari } = await import('../../src/domains/personal-health/engine/weeklyTraining.ts')
const w = (extra: Record<string, unknown> = {}) => ({ mulai: '2026-10-10T06:00:00Z', selesai: '2026-10-10T06:30:00Z', durasi: 1800, durationSource: 'source_field', jarakKm: 5, ...extra })
let r = ringkasLatihan([w(), w()])
assert.deepEqual([r.sesi, r.km, r.menit, r.detikPerKm], [2, 10, 60, 360])
r = ringkasLatihan([w(), w({ durasi: 0, durationSource: 'unknown' })])
assert.equal(r.menit, null, 'durasi tak diketahui bukan 0 menit')
assert.equal(r.detikPerKm, null, 'pace tidak dihitung dari durasi yang tidak lengkap')
assert.equal(r.km, 10)
r = ringkasLatihan([w({ jarakKm: undefined })])
assert.equal(r.detikPerKm, null); assert.equal(r.menit, 30)
r = ringkasLatihan([w({ durasi: 0, selesai: '2026-10-10T06:00:00Z' })])
assert.equal(r.menit, 0, 'nol sungguhan tetap 0'); assert.equal(r.detikPerKm, null, 'pace tidak dihitung dari 0 menit')
const kini = Date.parse('2026-10-16T12:00:00Z')
const hari = (n: number, extra: Record<string, unknown> = {}) => w({ mulai: new Date(kini - n * 864e5).toISOString(), ...extra })
const d = menitTujuhHari([hari(0), hari(1, { durasi: 0, durationSource: 'unknown' }), hari(1), hari(3, { durasi: 0, selesai: hari(3).mulai })], kini)
assert.deepEqual(d, [0, 0, 0, 0, 0, null, 30], 'hari dengan durasi tak diketahui = null; nol sungguhan dan hari tanpa sesi = 0')
const tile = readFileSync('src/components/tiles/UbinLangsung.tsx', 'utf8')
assert.match(tile, /ringkasLatihan\(sesi\)/, 'ubin memakai ringkasLatihan')
assert.doesNotMatch(tile, /w\.durasi \?\? 0/, 'tidak ada penjumlahan durasi mentah')
assert.match(tile, /menitTujuhHari\(getWorkouts\(\)\)/, 'ubin memakai menitTujuhHari')
assert.match(tile, /data-durasi-tidak-diketahui/, 'hari dengan durasi tak diketahui digambar berbeda dari 0')
console.log('ringkasan-latihan-durasi: ok')
