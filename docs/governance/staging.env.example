# Staging environment contract (ENG-E7-04). Names only; never commit real values.
# Provisioning is EXT-E7-B (infra owner). Until these exist, .github/workflows/staging-gate.yml
# fails closed with "staging credentials absent or invalid: <NAMES>".
#
# GitHub Actions: set STAGING_URL and STAGING_API_URL as repository *variables*, STAGING_DEPLOY_TOKEN as a *secret*.
# STAGING_URL and STAGING_API_URL must be https and must not point at panaceamed.id (production).
STAGING_URL=
STAGING_API_URL=
STAGING_DEPLOY_TOKEN=
