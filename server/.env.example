# Panaceamed.id backend configuration.
# Copy to ".env" and fill in. Any value left blank keeps that feature in MOCK mode.

# --- AI (OpenRouter — one key, many models) ---
OPENROUTER_API_KEY=
AI_CHAT_MODEL=google/gemini-3.5-flash
AI_EMR_MODEL=z-ai/glm-5.2
ANTHROPIC_API_KEY=

# --- Server ---
PORT=8787
CORS_ORIGINS=http://localhost:5173,https://rizkyazhar486.github.io
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false
# Development identity bypass. Keep false/blank normally. It is still disabled
# whenever NODE_ENV=production even if this value is accidentally set to true.
ALLOW_DEV_LOGIN=false

# --- Open-Meteo environment context ---
# The public free API is non-commercial only. For a commercial production
# deployment set OPEN_METEO_API_KEY; the server will automatically use the
# official customer forecast + air-quality hosts. For a self-hosted/licensed
# deployment set BOTH base URLs. A genuinely non-commercial production may
# explicitly opt into the public endpoint with OPEN_METEO_ALLOW_FREE_NONCOMMERCIAL=true.
OPEN_METEO_API_KEY=
OPEN_METEO_FORECAST_BASE_URL=
OPEN_METEO_AIR_QUALITY_BASE_URL=
OPEN_METEO_ALLOW_FREE_NONCOMMERCIAL=false

# --- Genomics compute bridge ---
GENOMICS_WORKER_URL=
GENOMICS_WORKER_TOKEN=
GENOMICS_WORKER_PROVIDER=render-worker
GENOMICS_WORKER_TIMEOUT_MS=30000

# --- Google OAuth (real login) ---
# Leave blank if Google login is not configured; use email OTP when RESEND_API_KEY
# is configured. Dev-login is local-only and requires ALLOW_DEV_LOGIN=true.
GOOGLE_CLIENT_ID=

# --- Midtrans payments ---
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

TOKEN_TO_IDR=1000

# --- Web Push notifications ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@panaceamed.id
