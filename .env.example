# Frontend configuration (Vite). Copy to ".env.local" to enable the backend.
# Leave blank/omit for the pure in-browser demo (GitHub Pages).

# Base URL of the Panaceamed backend (see ./server). Example for local dev:
VITE_API_URL=http://localhost:8787

# For You "Music" widget — Spotify Authorization Code with PKCE (no client secret needed).
# Leave unset to keep the widget in its honest "not configured" state.
# Register the app at https://developer.spotify.com/dashboard and add
# "<your-origin>/?t=for-you" as a redirect URI.
VITE_SPOTIFY_CLIENT_ID=

# Apple Music (MusicKit JS) has no client-side config var: it requires a server-signed
# developer token, which this repository does not yet issue. It stays "not configured"
# until a token-issuance endpoint exists.
