# Frontend configuration (Vite). Copy to ".env.local" to enable the backend.
# Leave blank/omit for the pure in-browser demo (GitHub Pages).

# Base URL of the Panaceamed backend (see ./server). Example for local dev:
VITE_API_URL=http://localhost:8787

# Google Sign-In client ID for the web build (public identifier, not a secret). Same value as the backend's
# GOOGLE_CLIENT_ID. With it set, the Google button shows even while the backend is waking up.
VITE_GOOGLE_CLIENT_ID=
